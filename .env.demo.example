# ============================================================
# .env.demo.example  |  2026-05-19
# Variables de entorno para la versión DEMO en Railway + Vercel
#
# Pasos:
#   1. Crea un proyecto MySQL en Railway (railway.app) — plan gratuito disponible.
#   2. Copia los datos de conexión que Railway genera (host, port, user, password, database).
#   3. En Vercel → Settings → Environment Variables, agrega cada variable de abajo.
#   4. (Opcional) Para desarrollo local copia este archivo a .env.local y rellena los valores.
#
# IMPORTANTE: Nunca subas .env.local ni este archivo con credenciales reales a git.
# ============================================================

# --- Conexión MySQL (Railway) ---
MYSQL_HOST=<tu-host>.railway.app
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<tu-password-railway>
MYSQL_DATABASE=railway

# --- Ciclo escolar que coincide con los datos del seed ---
# El script demo-seed.sql usa ciclo 25. Mantén este valor.
CICLO_ESCOLAR_ACTUAL=25

# --- Activa el banner de demo en la UI ---
# Pon 'true' en Vercel para que aparezca la barra amarilla identificadora.
NEXT_PUBLIC_DEMO_MODE=true
